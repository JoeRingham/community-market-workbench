# Copy to .env for local development. Never commit .env.

# --- Database (local Postgres via Docker for now; Neon later) ---
DATABASE_URL=postgres://market:market@localhost:5432/market?sslmode=disable

# --- Blob storage (Cloudflare R2 / S3-compatible) ---
BLOB_ENDPOINT=
BLOB_BUCKET=price-lists
BLOB_ACCESS_KEY_ID=
BLOB_SECRET_ACCESS_KEY=

# --- Inbound email webhook (later) ---
INBOUND_WEBHOOK_SIGNING_SECRET=

# --- Parser ---
# Path to the Python interpreter with pricelistparser installed (used by the Go ingest orchestrator).
PARSER_PYTHON=pricelistparser/.venv/bin/python
